# B3 Hive all-in-one container — copy to .env and fill in. NEVER commit .env.

# ── Mode ──
# true (default): daemon + backend + UI. false: headless daemon only (same image).
RUN_UI=true

# ── Node RPC (loopback inside the container; seeds b3coin.conf on FIRST RUN only) ──
# Generated randomly if left empty on first run.
RPC_USER=
RPC_PASSWORD=
RPC_PORT=32647

# ── UI / backend ──
WEB_PORT=8080
# Login password for the web UI (required when RUN_UI=true).
UI_PASSWORD=SET_ME
# Session secret — generate at deploy time, e.g.: openssl rand -hex 32
SESSION_SECRET=GENERATE_AT_DEPLOY

# ── Authentication & 2FA ──
# Require app login for all access.
AUTH_REQUIRED=1
# TOTP 2FA: required for remote access, bypassed on localhost.
# Set to false to always require 2FA (even from localhost).
LOCALHOST_SKIP_2FA=true
# Encryption key for TOTP secrets stored in the backend DB.
# Generate once: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=GENERATE_AT_DEPLOY

# ── Wallet ──
# Default unlock timeout in seconds (how long the wallet stays unlocked after passphrase entry).
WALLET_UNLOCK_TIMEOUT=60

# ── Monitoring ──
# Minutes with no new block before a stall alert fires.
STALL_ALERT_MINUTES=10
# Stall response level: alert (default) | restart | reindex
STALL_LEVEL=alert
# Explorer REST API for sync-lag comparison (leave empty to disable).
EXPLORER_URL=https://explorer.b3hive.io
# Webhook URL for alert/recovery notifications (Discord/Slack-compatible JSON POST).
# Leave empty to disable.
WEBHOOK_URL=
# Monitor poll interval in seconds.
MONITOR_INTERVAL=60

# ── TLS (production; see docker-compose.prod.yml + Caddyfile) ──
# Domain for auto-HTTPS via Caddy. Only used by the production compose profile.
B3_DOMAIN=

# --- Transport security (v0.5.0) ---
# Policy for remote plain-HTTP sessions: "warn" (default; persistent banner
# + Settings guide card, nothing blocked) or "block" (refuse remote plain-HTTP
# logins with 426; localhost and HTTPS are always allowed).
REQUIRE_SECURE_TRANSPORT=warn
# ECDH envelope encryption for the login password and wallet passphrase
# (cleartext secrets never cross the wire). Leave on.
ENVELOPE_ENCRYPTION=true
# Session cookie Secure flag: auto (default; secure when the connection is
# HTTPS), always, or never.
COOKIE_SECURE=auto
