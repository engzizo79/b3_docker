# Backend configuration — copy to .env and fill in. NEVER commit .env.

# Node RPC (internal Docker network)
B3_RPC_HOST=node
B3_RPC_PORT=32647
B3_RPC_USER=SET_ME
B3_RPC_PASS=SET_ME

# Backend
WEB_PORT=8080
SESSION_SECRET=GENERATE_AT_DEPLOY

# Auth
AUTH_REQUIRED=1
WALLET_2FA=passphrase

# Monitoring
STALL_ALERT_MINUTES=10
EXPLORER_COMPARE_URL=https://explorer.b3hive.io/api
