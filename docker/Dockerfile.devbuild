# B3 Hive — dev-build toolchain (docs/MULTINODE_PLAN.md Phase 4).
#
# Compiles an UNPUBLISHED B3-CoinV2 build (a branch/commit under test, e.g.
# FlowMesh) into the SAME fully-static "headless" binary set the project's
# own official release CI produces, so install_version() can install a dev
# build exactly the same way it installs a GitHub release — the only
# difference is where the tarball came from.
#
# NEVER pulled by normal users, NEVER referenced by the runtime image
# (docker/Dockerfile), and shares no base layer with it — this image only
# ever exists on the operator's own machine to produce one artifact.
#
# Build context = a LOCAL CHECKOUT of B3-CoinV2 (the branch/commit already
# checked out there — NOT cloned inside this Dockerfile, so no network
# access or credentials for a private/experimental branch are ever needed
# here). Run via scripts/build_devbuild.sh, which also extracts the result.
#
#   docker build -f docker/Dockerfile.devbuild \
#     --build-arg B3_BUILD_LABEL=flowmesh-$(git -C /path/to/B3-CoinV2 rev-parse --short HEAD) \
#     -t b3hive-devbuild:tmp /path/to/B3-CoinV2
#
# Mirrors B3-CoinV2's own .github/workflows/release-build.yml
# `linux-x86_64-static` job (same base image, same depends/cmake flags, same
# static-ELF + regtest smoke checks) — that recipe is the project's own
# proof this produces a working operator binary, so it is followed exactly
# rather than re-derived.
FROM mirror.gcr.io/alpine:3.23

RUN apk add --no-cache \
    bash binutils bison build-base cmake curl file git linux-headers \
    make ninja patch pkgconf python3 xz

WORKDIR /src
COPY . /src

# A free-text label for the packaged tarball's name only (e.g. a short
# commit sha or "flowmesh-2026-09-22") — never a signal of trust. The
# trust boundary for a dev build is "the operator compiled it", not the
# label; see docs/MULTINODE_PLAN.md Phase 4.3.
ARG B3_BUILD_LABEL=dev

RUN set -euxo pipefail; \
    git config --global --add safe.directory /src; \
    host="$(./depends/config.guess)"; \
    case "$host" in x86_64-pc-linux-musl|aarch64-*-linux-musl) ;; \
      *) echo "unsupported build host: $host" >&2; exit 1 ;; esac; \
    make -C depends HOST="$host" NO_QT=1 NO_QR=1 NO_ZMQ=1 \
      NO_USDT=1 NO_IPC=1 -j"$(nproc)"; \
    cmake -S . -B build-static \
      --toolchain "depends/$host/toolchain.cmake" \
      -DCMAKE_BUILD_TYPE=Release \
      -DAPPEND_LDFLAGS=-static-pie \
      -DCMAKE_SKIP_RPATH=TRUE \
      -DREDUCE_EXPORTS=ON \
      -DBUILD_GUI=OFF \
      -DBUILD_TESTS=OFF \
      -DBUILD_GUI_TESTS=OFF \
      -DENABLE_IPC=OFF \
      -DWITH_ZMQ=OFF \
      -DWITH_USDT=OFF \
      -DBUILD_TX=ON \
      -DBUILD_UTIL=ON \
      -DBUILD_WALLET_TOOL=ON; \
    cmake --build build-static -j"$(nproc)" --target \
      b3coind b3coin-cli b3coin-tx b3coin-util b3coin-wallet

# Same static-ELF + functional checks the official release CI runs — the
# binaries that back real validator stakes get the same bar as a GitHub
# release, dev build or not (docs/MULTINODE_PLAN.md Phase 4.3).
RUN set -euxo pipefail; \
    for binary in b3coind b3coin-cli b3coin-tx b3coin-util b3coin-wallet; do \
      file "build-static/bin/$binary" | grep -Eq "static-pie linked|statically linked"; \
      ! readelf -l "build-static/bin/$binary" | grep -q "Requesting program interpreter"; \
      ! readelf -d "build-static/bin/$binary" 2>&1 | grep -q NEEDED; \
      if [ "$binary" = b3coind ]; then \
        "build-static/bin/$binary" -nosettings -version >/dev/null; \
      else \
        "build-static/bin/$binary" -version >/dev/null; \
      fi; \
    done; \
    smoke_dir="$(mktemp -d)"; rpc_port=18455; \
    build-static/bin/b3coind -regtest -datadir="$smoke_dir" \
      -server -daemonwait -networkactive=0 -listen=0 -discover=0 \
      -dnsseed=0 -listenonion=0 -natpmp=0 -nosettings -rpcport="$rpc_port"; \
    build-static/bin/b3coin-cli -regtest -datadir="$smoke_dir" \
      -rpcport="$rpc_port" getblockchaininfo >/dev/null; \
    build-static/bin/b3coin-cli -regtest -datadir="$smoke_dir" \
      -rpcport="$rpc_port" createwallet devbuild-smoke >/dev/null; \
    build-static/bin/b3coin-cli -regtest -datadir="$smoke_dir" \
      -rpcport="$rpc_port" -rpcwallet=devbuild-smoke getwalletinfo >/dev/null; \
    build-static/bin/b3coin-cli -regtest -datadir="$smoke_dir" -rpcport="$rpc_port" stop; \
    for attempt in $(seq 1 300); do \
      test ! -f "$smoke_dir/regtest/b3coind.pid" && break; \
      sleep 0.1; \
    done; \
    test ! -f "$smoke_dir/regtest/b3coind.pid"; \
    rm -rf "$smoke_dir"

# Package exactly what install_version() (backend/app/daemon_release.py)
# expects: a tarball with a bin/ directory holding these five names —
# nothing more, nothing GUI/bridge/test related.
RUN set -euxo pipefail; \
    mkdir -p /out; \
    arch="$(uname -m)"; \
    name="b3-hive-${B3_BUILD_LABEL}-unsigned-linux-${arch}-static-headless-devbuild"; \
    stage="$(mktemp -d)"; \
    mkdir -p "$stage/$name/bin"; \
    cp build-static/bin/b3coind build-static/bin/b3coin-cli \
      build-static/bin/b3coin-tx build-static/bin/b3coin-util \
      build-static/bin/b3coin-wallet "$stage/$name/bin/"; \
    cp README.md COPYING "$stage/$name/" 2>/dev/null || true; \
    (cd "$stage" && tar -czf "/out/${name}.tar.gz" "$name"); \
    (cd /out && sha256sum "${name}.tar.gz" > "${name}.tar.gz.sha256"); \
    rm -rf "$stage"

CMD ["true"]
